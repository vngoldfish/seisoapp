# Frontend data provider
# Local storage mode is used when neither VITE_USE_POSTGRES nor Firebase vars are configured.
VITE_USE_POSTGRES=false
VITE_BACKEND_URL=http://localhost:4000

# Optional: enable production source maps only when you explicitly need deploy debugging.
VITE_ENABLE_SOURCEMAP=false

# Firebase mode (leave blank when using local storage or Postgres mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend/PostgreSQL mode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_before_deploy
POSTGRES_DB=seisoapp
DATABASE_URL=postgres://postgres:change_me_before_deploy@localhost:5432/seisoapp
PORT=4000
CORS_ORIGIN=http://localhost:8085
JSON_LIMIT=10mb
